{
  "manifest_version": 3,
  "name": "Site Seguro? - Analisador de Confiabilidade",
  "version": "1.2.2",
  "description": "Analisa se o site que você está visitando é seguro e confiável: HTTPS, reputação de domínio, typosquatting, sinais de phishing e checagem opcional no Google Safe Browsing.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://safebrowsing.googleapis.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
