{
  "manifest_version": 3,
  "name": "Site Seguro? - Analisador de Confiabilidade",
  "version": "1.3.0",
  "description": "Analisa sinais de risco em endereços de sites usando regras locais e, opcionalmente, o Google Safe Browsing.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "site-seguro@example.com",
      "strict_min_version": "109.0"
    }
  }
}
